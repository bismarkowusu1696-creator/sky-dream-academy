rules_version = '2';

// SkyDream production security rules.
//
// All sensitive academy data is accessed through Firebase Cloud Functions using
// the Admin SDK. The browser never receives direct Firestore read/write access,
// even after an admin or facilitator signs in. This prevents a visitor from
// bypassing the UI and reading/writing the shared storage documents directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
